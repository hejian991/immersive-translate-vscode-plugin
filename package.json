{
  "name": "immersive-translate-vscode-plugin",
  "displayName": "Immersive Translate for VS Code",
  "icon": "assets/icon.png",
  "description": "Translate text using Google, Bing, OpenAI, Gemini, or DeepSeek — inline or slide view, with concurrent multi-line translation.",
  "version": "0.1.2",
  "publisher": "hejian991",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hejian991/immersive-translate-vscode-plugin"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vscode-immersive-translate-plugin.translateToSlide",
    "onCommand:vscode-immersive-translate-plugin.translateToSlideOnlyTarget",
    "onCommand:vscode-immersive-translate-plugin.translateImmersive",
    "onCommand:vscode-immersive-translate-plugin.closeTranslateImmersive",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-immersive-translate-plugin.translateToSlide",
        "title": "Immersive Translate: View Translate to the Slide"
      },
      {
        "command": "vscode-immersive-translate-plugin.translateToSlideOnlyTarget",
        "title": "Immersive Translate: View Translate to the Slide (Only Target)"
      },
      {
        "command": "vscode-immersive-translate-plugin.translateImmersive",
        "title": "Immersive Translate: View Translate Immersive"
      },
      {
        "command": "vscode-immersive-translate-plugin.closeTranslateImmersive",
        "title": "Immersive Translate: Close Translate Immersive"
      }
    ],
    "keybindings": [
      {
        "command": "vscode-immersive-translate-plugin.translateToSlide",
        "key": "ctrl+alt+t",
        "mac": "ctrl+cmd+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "VSCode Immersive Translate Plugin",
      "properties": {
        "vscode-immersive-translate-plugin.apiProvider": {
          "type": "string",
          "default": "google-free",
"enum": [
"google-free",
"bing-free",
"google",
"bing",
"openai",
            "gemini",
            "deepseek"
],
"enumDescriptions": [
"Google Translate (Free, no API key required)",
"Bing Translate (Free, no API key required)",
"Google Cloud Translation API (Requires API key)",
"Microsoft Azure Translator API (Requires API key)",
"OpenAI GPT API (Requires API key)",
            "Google Gemini API (Requires API key)",
            "DeepSeek API (Requires API key)"
],
          "description": "Select the translation API provider."
        },
        "vscode-immersive-translate-plugin.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for OpenAI, Gemini, DeepSeek, Google, or Bing (when using paid APIs)."
        },
        "vscode-immersive-translate-plugin.sourceLanguage": {
          "type": "string",
          "default": "en",
          "description": "Source language code (e.g., 'en', 'auto')."
        },
        "vscode-immersive-translate-plugin.targetLanguage": {
          "type": "string",
          "default": "zh-CN",
          "description": "Target language code (e.g., 'zh-CN', 'en')."
        },
        "vscode-immersive-translate-plugin.concurrency": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Max lines per concurrent batch for Immersive and Slide modes (LLM numbered-batch or Promise.all). Default 5."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "@vscode/vsce": "^3.7.1"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
